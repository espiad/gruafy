# =============================================================================
# gruafy — variables de entorno. Copiá este archivo a .env.local y completá.
# NUNCA versiones valores reales. Solo nombres y descripciones acá.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=gruafy
NODE_ENV=development
# Habilita simulador de ubicación y atajos de QA. En producción DEBE ser false.
DEMO_MODE=true

# --- Supabase (público) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública nueva (publishable). Si tu proyecto usa la anon key clásica,
# completá NEXT_PUBLIC_SUPABASE_ANON_KEY y dejá esta vacía.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (privado / CLI) ------------------------------------------------
# La service role key JAMÁS se expone al navegador. Solo server-side.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# --- Mercado Pago ------------------------------------------------------------
# test | production. En production solo se usan las credenciales productivas.
PAYMENTS_MODE=test
MERCADOPAGO_TEST_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_TEST_PUBLIC_KEY=
MERCADOPAGO_PRODUCTION_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PRODUCTION_PUBLIC_KEY=
# Secreto de firma del webhook (x-signature) configurado en el panel de MP.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Mapas -------------------------------------------------------------------
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# --- Administrador -----------------------------------------------------------
# El usuario con este email queda promovido a admin de forma segura (server-side).
ADMIN_EMAIL=

# --- Contacto ----------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Legales (requeridos para producción) ------------------------------------
# Sin razón social + CUIT reales, el build de producción se bloquea.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CUIT=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=

# --- OAuth Google (opcional) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Observabilidad (opcional) -----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Deploy por CLI (opcional) -----------------------------------------------
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
